module Spotted
  module Models
    module Playlists
      type image_list_params =
        { playlist_id: String } & Spotted::Internal::Type::request_parameters

      class ImageListParams < Spotted::Internal::Type::BaseModel
        extend Spotted::Internal::Type::RequestParameters::Converter
        include Spotted::Internal::Type::RequestParameters

        attr_accessor playlist_id: String

        def initialize: (
          playlist_id: String,
          ?request_options: Spotted::request_opts
        ) -> void

        def to_hash: -> {
          playlist_id: String,
          request_options: Spotted::RequestOptions
        }
      end
    end
  end
end
