module Spotted
  module Models
    type track_retrieve_params =
      { id: String, market: String }
      & Spotted::Internal::Type::request_parameters

    class TrackRetrieveParams < Spotted::Internal::Type::BaseModel
      extend Spotted::Internal::Type::RequestParameters::Converter
      include Spotted::Internal::Type::RequestParameters

      attr_accessor id: String

      attr_reader market: String?

      def market=: (String) -> String

      def initialize: (
        id: String,
        ?market: String,
        ?request_options: Spotted::request_opts
      ) -> void

      def to_hash: -> {
        id: String,
        market: String,
        request_options: Spotted::RequestOptions
      }
    end
  end
end
